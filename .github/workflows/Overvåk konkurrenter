name: Overvåk konkurrenter
on:
  schedule:
    - cron: '0 6 * * 1'
  workflow_dispatch:
permissions:
  contents: write
jobs:
  konkurrenter:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '22'
      - name: Overvåk konkurrenter
        env:
          DOFFIN_API_KEY: ${{ secrets.DOFFIN_API_KEY }}
        run: node konkurrenter.js
      - name: Lagre data
        run: |
          git config user.name "signal-robot"
          git config user.email "actions@github.com"
          git add konkurrenter-data.json
          git diff --staged --quiet || git commit -m "Konkurrentdata $(date +%F)"
          git push
